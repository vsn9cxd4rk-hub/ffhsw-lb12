# =============================================================================
# Feuerwehr Management System - Docker Compose Umgebungsvariablen
# Kopieren nach ".env" (im selben Verzeichnis wie docker-compose.yml) und
# alle Platzhalter durch echte Werte ersetzen. ".env" NICHT committen.
# =============================================================================

# --- Datenbank ---
DB_NAME=feuerwehrmanagementsystem
DB_USER=feuerwehr
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- JWT Secret - Pflicht, zufällig, mind. 32 Zeichen (z.B. "openssl rand -base64 48") ---
# Das Backend startet nicht, wenn es fehlt, zu kurz oder ein Platzhalter ist.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
# Sitzung endet nach so vielen Tagen ohne Nutzung
JWT_REFRESH_EXPIRES=7d

# --- CORS: Origin, unter der das Frontend erreichbar ist ---
CORS_ORIGIN=http://localhost

# --- Host-Port, unter dem das Frontend (nginx) veröffentlicht wird ---
HTTP_PORT=80

# --- Logging ---
LOG_LEVEL=info

# --- Email (SMTP), optional ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@feuerwehr.local

# --- Image-Version (siehe build.sh) ---
APP_VERSION=1.1.0
