# Quelltext und Konfiguration immer mit LF, auch wenn unter Windows bearbeitet.
# Bewusst nur gezielte Typen: README.md und die Dateien unter data/ liegen mit
# CRLF im Repository und bleiben unverändert.
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.prisma     text eol=lf
*.sql        text eol=lf
*.yml        text eol=lf
*.conf       text eol=lf
*.example    text eol=lf
*.Dockerfile text eol=lf

# Shell-Skripte laufen mit CRLF auf Linux nicht
*.sh         text eol=lf

# PowerShell erwartet CRLF
*.ps1        text eol=crlf
