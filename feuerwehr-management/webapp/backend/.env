NODE_ENV=development
PORT=3001

# MySQL connection string
DATABASE_URL="mysql://LB12NEW:%23PPM4alltests@localhost:3306/LB12NEW"

# JWT Secrets - CHANGE IN PRODUCTION!
JWT_ACCESS_SECRET=your-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS - comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000

# File uploads
UPLOAD_PATH=/var/www/fuerwehr/uploads

# Logging
LOG_LEVEL=info
LOG_PATH=/var/log/fuerwehr

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@feuerwehr.local
