generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USER MANAGEMENT ====================

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(100)
  email     String?  @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  name      String?  @db.VarChar(255)
  isAdmin   Boolean  @default(false)
  isActive  Boolean  @default(true)
  groupId   Int?
  memberId  Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group         PermissionGroup? @relation(fields: [groupId], references: [id])
  member        Member?          @relation(fields: [memberId], references: [id])
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(512)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PermissionGroup {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)

  // 76 permission bits (BR0-BR75)
  br0  Boolean @default(false)
  br1  Boolean @default(false)
  br2  Boolean @default(false)
  br3  Boolean @default(false)
  br4  Boolean @default(false)
  br5  Boolean @default(false)
  br6  Boolean @default(false)
  br7  Boolean @default(false)
  br8  Boolean @default(false)
  br9  Boolean @default(false)
  br10 Boolean @default(false)
  br11 Boolean @default(false)
  br12 Boolean @default(false)
  br13 Boolean @default(false)
  br14 Boolean @default(false)
  br15 Boolean @default(false)
  br16 Boolean @default(false)
  br17 Boolean @default(false)
  br18 Boolean @default(false)
  br19 Boolean @default(false)
  br20 Boolean @default(false)
  br21 Boolean @default(false)
  br22 Boolean @default(false)
  br23 Boolean @default(false)
  br24 Boolean @default(false)
  br25 Boolean @default(false)
  br26 Boolean @default(false)
  br27 Boolean @default(false)
  br28 Boolean @default(false)
  br29 Boolean @default(false)
  br30 Boolean @default(false)
  br31 Boolean @default(false)
  br32 Boolean @default(false)
  br33 Boolean @default(false)
  br34 Boolean @default(false)
  br35 Boolean @default(false)
  br36 Boolean @default(false)
  br37 Boolean @default(false)
  br38 Boolean @default(false)
  br39 Boolean @default(false)
  br40 Boolean @default(false)
  br41 Boolean @default(false)
  br42 Boolean @default(false)
  br43 Boolean @default(false)
  br44 Boolean @default(false)
  br45 Boolean @default(false)
  br46 Boolean @default(false)
  br47 Boolean @default(false)
  br48 Boolean @default(false)
  br49 Boolean @default(false)
  br50 Boolean @default(false)
  br51 Boolean @default(false)
  br52 Boolean @default(false)
  br53 Boolean @default(false)
  br54 Boolean @default(false)
  br55 Boolean @default(false)
  br56 Boolean @default(false)
  br57 Boolean @default(false)
  br58 Boolean @default(false)
  br59 Boolean @default(false)
  br60 Boolean @default(false)
  br61 Boolean @default(false)
  br62 Boolean @default(false)
  br63 Boolean @default(false)
  br64 Boolean @default(false)
  br65 Boolean @default(false)
  br66 Boolean @default(false)
  br67 Boolean @default(false)
  br68 Boolean @default(false)
  br69 Boolean @default(false)
  br70 Boolean @default(false)
  br71 Boolean @default(false)
  br72 Boolean @default(false)
  br73 Boolean @default(false)
  br74 Boolean @default(false)
  br75 Boolean @default(false)

  users User[]

  @@map("permission_groups")
}

// ==================== MEMBER / PERSONAL MANAGEMENT ====================

model MemberGroup {
  id                  Int     @id @default(autoincrement())
  name                String  @db.VarChar(100)
  employeeNumberPrefix String? @db.VarChar(20)
  nextEmployeeNumber  Int     @default(1)

  members Member[]

  @@map("member_groups")
}

model Member {
  id              Int       @id @default(autoincrement())
  groupId         Int?
  salutation      String?   @db.VarChar(20)
  lastName        String    @db.VarChar(100)
  firstName       String    @db.VarChar(100)
  street          String?   @db.VarChar(255)
  city            String?   @db.VarChar(100)
  phonePrivate    String?   @db.VarChar(50)
  phoneMobile     String?   @db.VarChar(50)
  phoneWork       String?   @db.VarChar(50)
  telegramId      String?   @db.VarChar(100)
  email           String?   @db.VarChar(255)
  email2          String?   @db.VarChar(255)
  occupation      String?   @db.VarChar(255)
  nationality     String?   @db.VarChar(100)
  rank            String?   @db.VarChar(100)
  isInactive      Boolean   @default(false)
  memberSince     DateTime?
  memberUntil     DateTime?
  birthDate       DateTime?
  marriageDate    DateTime?
  comment         String?   @db.Text
  driverLicenseNo String?   @db.VarChar(100)
  driverAuthNo    String?   @db.VarChar(100)
  serviceCardNo   String?   @db.VarChar(100)
  healthInsurance String?   @db.VarChar(255)
  medications     String?   @db.Text
  conditions      String?   @db.Text
  swimmingBadge   String?   @db.VarChar(100)
  sportsRating    String?   @db.VarChar(100)
  emailDisabled       Boolean   @default(false)
  qualLicenseC        Boolean   @default(false)
  qualLicenseB        Boolean   @default(false)
  qualFirstAid        Boolean   @default(false)
  qualRadioOperator   Boolean   @default(false)
  qualMachinist       Boolean   @default(false)
  qualTruppmann       Boolean   @default(false)
  qualTruppfuehrer    Boolean   @default(false)
  qualGruppenfuehrer  Boolean   @default(false)
  qualZugfuehrer      Boolean   @default(false)
  qualRettSan         Boolean   @default(false)
  qualFwSan           Boolean   @default(false)
  qualVerbandfuehrer  Boolean   @default(false)
  qualAGT             Boolean   @default(false)
  qualTH1             Boolean   @default(false)
  tenantId            Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  group        MemberGroup?       @relation(fields: [groupId], references: [id])
  user         User?
  family       MemberFamily[]
  work         MemberWork?
  bank         MemberBank?
  examination  MemberExamination?
  agtRecords   AgtRecord[]
  availability MemberAvailability[]
  courses      Course[]
  attendances  Attendance[]
  absences     Absence[]
  history      MemberHistory[]
  operationPersonnel OperationPersonnel[]

  @@map("members")
}

model MemberFamily {
  id           Int     @id @default(autoincrement())
  memberId     Int
  name         String  @db.VarChar(255)
  phone        String? @db.VarChar(50)
  phone2       String? @db.VarChar(50)
  email        String? @db.VarChar(255)
  street       String? @db.VarChar(255)
  city         String? @db.VarChar(100)
  relationship String? @db.VarChar(100)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_family")
}

model MemberWork {
  id            Int     @id @default(autoincrement())
  memberId      Int     @unique
  employer      String? @db.VarChar(255)
  street        String? @db.VarChar(255)
  city          String? @db.VarChar(100)
  phone         String? @db.VarChar(50)
  contactPerson String? @db.VarChar(255)
  email         String? @db.VarChar(255)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_work")
}

model MemberBank {
  id       Int     @id @default(autoincrement())
  memberId Int     @unique
  iban     String? @db.VarChar(34)
  bic      String? @db.VarChar(11)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_bank")
}

model MemberExamination {
  id               Int       @id @default(autoincrement())
  memberId         Int       @unique
  g25Date          DateTime?
  g26Date          DateTime?
  g30Date          DateTime?
  agtTrainingDate  DateTime?
  lkwLicenseExpiry DateTime?
  notifyG25        Boolean   @default(false)
  notifyG26        Boolean   @default(false)
  notifyG30        Boolean   @default(false)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_examinations")
}

model AgtRecord {
  id         Int      @id @default(autoincrement())
  memberId   Int
  type       String   @db.VarChar(50) // g26, belastung, einsatzuebung, einsatz
  date       DateTime
  result     String?  @db.VarChar(50) // geeignet, nicht_geeignet (only for g26)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("agt_records")
}

model MemberAvailability {
  id         Int       @id @default(autoincrement())
  memberId   Int
  status     String    @db.VarChar(50)
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  notes      String?   @db.VarChar(500)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_availability")
}

model MemberHistory {
  id         Int      @id @default(autoincrement())
  memberId   Int
  field      String   @db.VarChar(100)
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  changedBy  String   @db.VarChar(100)
  changedAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_history")
}

// ==================== VEHICLE / FAHRZEUG MANAGEMENT ====================

model Vehicle {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  description  String? @db.Text
  licensePlate String? @db.VarChar(20)
  callSign     String? @db.VarChar(50)
  seats        Int?
  minCrew      Int?
  maxCrew      Int?
  licenseClass String? @db.VarChar(20)
  isRetired    Boolean @default(false)
  isTrailer    Boolean @default(false)
  sortOrder    Int     @default(0)
  tenantId     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inspection          VehicleInspection?
  logbook             LogbookEntry[]
  equipmentInspections EquipmentInspection[]
  assignedInventory   ArticleAssignment[]
  warehouses          Warehouse[]

  @@map("vehicles")
}

model VehicleInspection {
  id            Int       @id @default(autoincrement())
  vehicleId     Int       @unique
  tuevDate      DateTime?
  spDate        DateTime?
  serviceDate   DateTime?
  notifyTuev    Boolean   @default(false)
  notifySp      Boolean   @default(false)
  notifyService Boolean   @default(false)
  notes         String?   @db.Text

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_inspections")
}

model LogbookEntry {
  id           Int      @id @default(autoincrement())
  vehicleId    Int
  date         DateTime
  driver       String   @db.VarChar(255)
  startMileage Int
  endMileage   Int
  purpose      String   @db.VarChar(500)
  destination  String?  @db.VarChar(500)
  notes        String?  @db.Text

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("logbook_entries")
}

model EquipmentInspection {
  id             Int       @id @default(autoincrement())
  vehicleId      Int
  type           String    @db.VarChar(100)
  lastInspection DateTime?
  nextInspection DateTime?
  notes          String?   @db.Text
  notifyDue      Boolean   @default(false)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("equipment_inspections")
}

// ==================== DEVICE CLASSES / GERÄTEKLASSEN ====================

model DeviceClass {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  subclasses DeviceSubclass[]

  @@map("device_classes")
}

model DeviceSubclass {
  id            Int      @id @default(autoincrement())
  deviceClassId Int
  name          String   @db.VarChar(255)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  deviceClass DeviceClass           @relation(fields: [deviceClassId], references: [id], onDelete: Cascade)
  criteria    InspectionCriterion[]
  articles    Article[]

  @@unique([deviceClassId, name])
  @@map("device_subclasses")
}

model InspectionCriterion {
  id               Int      @id @default(autoincrement())
  deviceSubclassId Int
  name             String   @db.VarChar(255)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  deviceSubclass DeviceSubclass              @relation(fields: [deviceSubclassId], references: [id], onDelete: Cascade)
  results        InspectionCriterionResult[]

  @@map("inspection_criteria")
}

model InspectionCriterionResult {
  id           Int    @id @default(autoincrement())
  inspectionId Int
  criterionId  Int
  result       String @db.VarChar(10)

  inspection ArticleInspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  criterion  InspectionCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([inspectionId, criterionId])
  @@map("inspection_criterion_results")
}

// ==================== PRÜFUNGSARTEN ====================

model InspectionType {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  inspections ArticleInspection[]
  schedules   ArticleInspectionSchedule[]

  @@map("inspection_types")
}

// ==================== INVENTORY / BESTANDSLISTE ====================

model Warehouse {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  vehicleId   Int?
  createdAt   DateTime @default(now())

  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  articles     Article[]
  assignments  ArticleAssignment[]

  @@map("warehouses")
}

model Article {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(255)
  manufacturer       String?   @db.VarChar(255)
  articleType        String?   @db.VarChar(100)
  description        String?   @db.Text
  inspectionInterval Int?
  imagePath          String?   @db.VarChar(500)
  value              Decimal?  @db.Decimal(10, 2)
  ean                String?   @db.VarChar(50)
  isExtinguisher     Boolean   @default(false)
  inventoryNumber    String?   @unique @db.VarChar(100)
  warehouseId        Int?
  deviceSubclassId   Int?
  manufacturingDate  DateTime?
  specification      String?   @db.VarChar(500)
  serialNumber       String?   @db.VarChar(255)
  din                     String?   @db.VarChar(100)
  isDecommissioned        Boolean   @default(false)
  designationLB           String?   @default("LB12") @db.VarChar(100)
  commissionedDate        DateTime?
  decommissionedDate      DateTime?
  communityInventoryNumber String?  @db.VarChar(100)
  mpFeuerInventoryNumber  String?   @db.VarChar(100)
  retirementPeriodMonths  Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  warehouse           Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  deviceSubclass      DeviceSubclass?             @relation(fields: [deviceSubclassId], references: [id], onDelete: SetNull)
  assignments         ArticleAssignment[]
  inspections         ArticleInspection[]
  documents           ArticleDocument[]
  inspectionStandards ArticleInspectionStandard[]
  inspectionSchedules ArticleInspectionSchedule[]
  defects             ArticleDefect[]
  repairs             ArticleRepair[]

  @@map("articles")
}

model ArticleInspection {
  id               Int       @id @default(autoincrement())
  articleId        Int
  inspectionTypeId Int?
  inspectedAt      DateTime
  inspectedBy      String    @db.VarChar(255)
  result           String    @db.VarChar(50)
  notes            String?   @db.Text
  nextDueDate      DateTime?
  createdAt        DateTime  @default(now())

  article          Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  inspectionType   InspectionType?             @relation(fields: [inspectionTypeId], references: [id], onDelete: SetNull)
  criterionResults InspectionCriterionResult[]
  documents        InspectionDocument[]

  @@map("article_inspections")
}

model ArticleAssignment {
  id          Int      @id @default(autoincrement())
  articleId   Int
  warehouseId Int
  vehicleId   Int?
  quantity    Int      @default(1)
  assignedTo  String?  @db.VarChar(255)
  assignedAt  DateTime @default(now())
  notes       String?  @db.VarChar(500)

  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@map("article_assignments")
}

model ArticleDocument {
  id         Int      @id @default(autoincrement())
  articleId  Int
  fileName   String   @db.VarChar(255)
  filePath   String   @db.VarChar(500)
  fileSize   Int
  mimeType   String   @db.VarChar(100)
  uploadedBy String   @db.VarChar(100)
  createdAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_documents")
}

model InspectionDocument {
  id           Int      @id @default(autoincrement())
  inspectionId Int
  fileName     String   @db.VarChar(255)
  filePath     String   @db.VarChar(500)
  fileSize     Int
  mimeType     String   @db.VarChar(100)
  uploadedBy   String   @db.VarChar(100)
  createdAt    DateTime @default(now())

  inspection ArticleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_documents")
}

model ArticleInspectionStandard {
  id          Int      @id @default(autoincrement())
  articleId   Int
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_inspection_standards")
}

model ArticleInspectionSchedule {
  id               Int @id @default(autoincrement())
  articleId        Int
  inspectionTypeId Int
  intervalMonths   Int

  article        Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  inspectionType InspectionType @relation(fields: [inspectionTypeId], references: [id], onDelete: Cascade)

  @@unique([articleId, inspectionTypeId])
  @@map("article_inspection_schedules")
}

model ArticleDefect {
  id          Int       @id @default(autoincrement())
  articleId   Int?
  subject     String?   @db.VarChar(255)
  reportedBy  String    @db.VarChar(255)
  reportedAt  DateTime
  description String    @db.Text
  severity    String    @db.VarChar(20)
  status      String    @default("open") @db.VarChar(20)
  resolvedAt  DateTime?
  resolvedBy  String?   @db.VarChar(255)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  article Article?       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  repairs ArticleRepair[]

  @@map("article_defects")
}

model ArticleRepair {
  id          Int       @id @default(autoincrement())
  articleId   Int?
  subject     String?   @db.VarChar(255)
  defectId    Int?
  repairedAt  DateTime
  repairedBy  String    @db.VarChar(255)
  description String    @db.Text
  cost        Decimal?  @db.Decimal(10, 2)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  article Article?      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  defect  ArticleDefect? @relation(fields: [defectId], references: [id], onDelete: SetNull)

  @@map("article_repairs")
}

// ==================== OPERATIONS / EINSÄTZE ====================

model Operation {
  id              Int       @id @default(autoincrement())
  operationNumber String?   @db.VarChar(50)
  officialNumber  String?   @db.VarChar(50)
  date            DateTime
  alarmTime       String?   @db.VarChar(10)
  departureTime   String?   @db.VarChar(10)
  arrivalTime     String?   @db.VarChar(10)
  returnTime      String?   @db.VarChar(10)
  location        String    @db.VarChar(500)
  district        String?   @db.VarChar(100)
  keyword         String?   @db.VarChar(255)
  vehicles        String?   @db.Text
  description     String?   @db.Text
  leaderCount     Int       @default(0)
  memberCount     Int       @default(0)
  commanderId     Int?
  commanderBfId   Int?
  categoryId      Int?
  tenantId        Int?
  reportType          String?   @db.VarChar(30)
  ilsOrderNumber      String?   @db.VarChar(50)
  callerInfo          String?   @db.Text
  policeInfo          String?   @db.Text
  situationOnArrival  String?   @db.Text
  actionsTaken        String?   @db.Text
  resourcesUsed       String?   @db.Text
  operationType       String?   @db.VarChar(100)
  rescuedPersons      Int       @default(0)
  injuredFirefighters Int       @default(0)
  deceasedPersons     Int       @default(0)
  deceasedFirefighters Int      @default(0)
  createdByName       String?   @db.VarChar(100)
  authorRole          String?   @db.VarChar(50)
  operationResult     String?   @db.VarChar(30)
  wasActivelyInvolved Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  times     OperationTime[]
  reports   OperationReport[]
  documents OperationDocument[]
  personnel OperationPersonnel[]

  @@map("operations")
}

model OperationTime {
  id            Int     @id @default(autoincrement())
  operationId   Int
  vehicleId     Int?
  vehicleName   String  @db.VarChar(100)
  alarmTime     String? @db.VarChar(10)
  departureTime String? @db.VarChar(10)
  arrivalTime   String? @db.VarChar(10)
  returnTime    String? @db.VarChar(10)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("operation_times")
}

model OperationReport {
  id          Int      @id @default(autoincrement())
  operationId Int
  content     String   @db.Text
  createdBy   String   @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("operation_reports")
}

model OperationDocument {
  id          Int      @id @default(autoincrement())
  operationId Int
  fileName    String   @db.VarChar(255)
  filePath    String   @db.VarChar(500)
  fileSize    Int
  mimeType    String   @db.VarChar(100)
  uploadedBy  String   @db.VarChar(100)
  createdAt   DateTime @default(now())

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("operation_documents")
}

model OperationPersonnel {
  id          Int    @id @default(autoincrement())
  operationId Int
  memberId    Int
  vehicleName String @db.VarChar(100)
  function    String @db.VarChar(50)
  section     String @default("deployed") @db.VarChar(20)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("operation_personnel")
}

// ==================== EVENTS / VERANSTALTUNGEN ====================

model Event {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(255)
  name2               String?   @db.VarChar(255)
  category            Int       @default(2) // 1=Einsatz, 2=Dienstabend, 3=BSW, 4=Sonstige
  date                DateTime
  startTime           String?   @db.VarChar(10)
  endTime             String?   @db.VarChar(10)
  hasVehicleAssignment Boolean  @default(false)
  infoSent            Boolean   @default(false)
  notes               String?   @db.Text
  tenantId            Int?
  createdAt           DateTime  @default(now())

  attendances Attendance[]
  documents   EventDocument[]

  @@map("events")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  year      Int
  eventId   Int
  memberId  Int
  status    String   @default("present") @db.VarChar(20) // present, absent, excused
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@map("attendances")
}

model Absence {
  id       Int      @id @default(autoincrement())
  memberId Int
  eventId  Int?
  date     DateTime
  reason   Int      @default(0)
  notes    String?  @db.Text

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("absences")
}

model FireWatch {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  date      DateTime
  startTime String?  @db.VarChar(10)
  endTime   String?  @db.VarChar(10)
  location  String?  @db.VarChar(500)
  notes     String?  @db.Text
  tenantId  Int?
  createdAt DateTime @default(now())

  @@map("fire_watches")
}

// ==================== TRAINING / AUSBILDUNG ====================

model CourseCategory {
  id                 Int     @id @default(autoincrement())
  name               String  @db.VarChar(100)
  description        String? @db.VarChar(500)
  qualificationField String? @db.VarChar(50)

  courses Course[]

  @@map("course_categories")
}

model Course {
  id              Int       @id @default(autoincrement())
  memberId        Int
  categoryId      Int
  status          String    @default("pending") @db.VarChar(50) // pending, active, completed, failed
  startDate       DateTime?
  endDate         DateTime?
  location        String?   @db.VarChar(255)
  notes           String?   @db.Text
  certificatePath String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category CourseCategory @relation(fields: [categoryId], references: [id])

  @@map("courses")
}

model EventDocument {
  id          Int      @id @default(autoincrement())
  eventId     Int
  fileName    String   @db.VarChar(255)
  filePath    String   @db.VarChar(500)
  fileSize    Int
  mimeType    String   @db.VarChar(100)
  uploadedBy  String   @db.VarChar(100)
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_documents")
}

// ==================== TEMPLATES ====================

model Template {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  filePath  String   @db.VarChar(500)
  fileSize  Int
  mimeType  String   @db.VarChar(100)
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history TemplateHistory[]

  @@map("templates")
}

model TemplateHistory {
  id         Int      @id @default(autoincrement())
  templateId Int
  action     String   @db.VarChar(50)
  changedBy  String   @db.VarChar(100)
  changedAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_history")
}

// ==================== REFERENCE DATA ====================

model Rank {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(100)
  abbreviation String @db.VarChar(20)
  sortOrder    Int    @default(0)

  @@map("ranks")
}

model AbsenceReason {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(100)
  color String? @db.VarChar(20)

  @@map("absence_reasons")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Year {
  id       Int     @id @default(autoincrement())
  year     Int     @unique
  isActive Boolean @default(false)

  @@map("years")
}
