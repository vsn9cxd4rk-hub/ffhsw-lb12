NODE_ENV=production
PORT=3001

# MySQL connection string (Sonderzeichen im Passwort URL-kodieren, z.B. # -> %23)
DATABASE_URL="mysql://feuerwehr:<passwort>@localhost:3306/feuerwehrmanagementsystem"

# JWT Secrets - Pflicht, zufällig, mind. 32 Zeichen (z.B. "openssl rand -base64 48").
# Das Backend startet nicht, wenn sie fehlen, zu kurz oder Platzhalter sind.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
# Lifetime of a login session (refresh cookie), in days
JWT_REFRESH_EXPIRES=7d
# Refresh cookie gets the Secure flag automatically when served via HTTPS (X-Forwarded-Proto).
# Set to true to force it, e.g. behind a TLS proxy that does not forward the scheme.
COOKIE_SECURE=false

# CORS - comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000

# File uploads
UPLOAD_PATH=/var/www/feuerwehrmanagement/uploads

# Logging
LOG_LEVEL=info
LOG_PATH=/var/log/feuerwehrmanagement

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@feuerwehr.local
