<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.feuerwehr</groupId>
    <artifactId>feuerwehr-management-system</artifactId>
    <version>3.21</version>
    <packaging>jar</packaging>

    <name>Feuerwehr Management System</name>
    <description>Verwaltungssoftware für Feuerwehren</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mainClass>StartFeuerwehrManagementSystem</mainClass>
    </properties>

    <dependencies>

        <!-- ===== Lokale JARs (lib/) ===== -->

        <!-- Eigene Basisklassen: logging, utilities.MyEvent, utilities.hash etc. -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>BasicClasses</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- Eigener Hashcode-Generator -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>HashCodeCreator</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- Eigene Verschlüsselungsbibliothek (jensen.verschluesselung) -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>encription</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- Windows-Verknüpfungen (jshortcut) -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>jshortcut</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- Sun PDF Renderer (com.sun.pdfview) -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>PDFRenderer</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- SQLite JDBC (ältere Version v056) -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>sqlitejdbc</artifactId>
            <version>v056</version>
        </dependency>

        <!-- ICEpdf PDF-Viewer (Core) -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>icepdf-core</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- ICEpdf PDF-Viewer (Viewer-Komponente) -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>icepdf-viewer</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- JTattoo Look & Feel -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>JTattoo</artifactId>
            <version>1.6.11</version>
        </dependency>

        <!-- JavaMail: Versand (SMTP) -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>smtp</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- JavaMail: Empfang (POP3) -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>pop3</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- JavaMail: Mail-API -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>mailapi</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- JavaMail: Mail -->
        <dependency>
            <groupId>de.feuerwehr.local</groupId>
            <artifactId>mail</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- ===== Maven Central Abhängigkeiten ===== -->

        <!-- Apache Commons Net (FTP, Netzwerk) -->
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
            <version>3.6</version>
        </dependency>

        <!-- Apache Commons Lang 3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.4</version>
        </dependency>

        <!-- Apache Commons Lang 2 -->
        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.6</version>
        </dependency>

        <!-- Apache Commons IO -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.5</version>
        </dependency>

        <!-- Apache Commons Codec -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.8</version>
        </dependency>

        <!-- Apache Commons Logging -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.1.3</version>
        </dependency>

        <!-- iText PDF 5 -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.3.0</version>
        </dependency>

        <!-- JFreeChart (Diagramme/Statistiken) -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>1.0.17</version>
        </dependency>

        <!-- JCommon (JFreeChart Abhängigkeit) -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jcommon</artifactId>
            <version>1.0.21</version>
        </dependency>

        <!-- JSch (SSH/SFTP) -->
        <dependency>
            <groupId>com.jcraft</groupId>
            <artifactId>jsch</artifactId>
            <version>0.1.51</version>
        </dependency>

        <!-- MySQL Connector/J -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>5.1.18</version>
        </dependency>

        <!-- Groovy (Scripting) -->
        <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy-all</artifactId>
            <version>2.1.7</version>
        </dependency>

        <!-- iCal4j (Kalender/ICS) -->
        <dependency>
            <groupId>org.mnode.ical4j</groupId>
            <artifactId>ical4j</artifactId>
            <version>1.0.6</version>
        </dependency>

        <!-- Backport Util Concurrent -->
        <dependency>
            <groupId>backport-util-concurrent</groupId>
            <artifactId>backport-util-concurrent</artifactId>
            <version>3.1</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <encoding>UTF-8</encoding>
                    <!-- Warnungen für dekompilierten Code unterdrücken -->
                    <compilerArgs>
                        <arg>-Xlint:none</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Executable Fat-JAR (mit allen Abhängigkeiten) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>executable</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                </transformer>
                            </transformers>
                            <!-- System-scope JARs explizit einschließen -->
                            <includeSystemScope>true</includeSystemScope>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Ressourcen einbinden -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <!-- Bilder nicht filtern, nur kopieren -->
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>jpg</nonFilteredFileExtension>
                        <nonFilteredFileExtension>png</nonFilteredFileExtension>
                        <nonFilteredFileExtension>ico</nonFilteredFileExtension>
                        <nonFilteredFileExtension>gif</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <repositories>
        <!-- Projektlokales Repo für custom JARs (de.feuerwehr.local) -->
        <repository>
            <id>local-maven-repo</id>
            <name>Local Project Repository</name>
            <url>file://${project.basedir}/local-maven-repo</url>
        </repository>
        <!-- iCal4j Repo -->
        <repository>
            <id>modularity-releases</id>
            <name>Modularity Releases Repository</name>
            <url>https://modularity.net/repository/releases/</url>
        </repository>
    </repositories>

</project>
